{
 "atomic": false,
 "steps": [
  {
   "tool": "eclipse_show_view",
   "label": "open the Project Explorer",
   "arguments": {
    "view": "org.eclipse.ui.navigator.ProjectExplorer",
    "activate": true
   },
   "expect": {
    "shown": true
   }
  },
  {
   "tool": "eclipse_wait_until_quiet",
   "label": "let it settle",
   "arguments": {
    "timeoutSeconds": 20
   },
   "expect": {
    "state": "quiet"
   }
  },
  {
   "tool": "eclipse_set_selection",
   "label": "select a shared project",
   "arguments": {
    "part": "org.eclipse.ui.navigator.ProjectExplorer",
    "elements": [
     "/org.eclipse.compare"
    ]
   },
   "expect": {
    "resolved": 1
   }
  },
  {
   "tool": "eclipse_get_context_menu",
   "label": "Pull is offered and enabled",
   "arguments": {
    "part": "org.eclipse.ui.navigator.ProjectExplorer",
    "path": "Team",
    "maxDepth": 3
   },
   "expect": {
    "found": true,
    "items[command=org.eclipse.egit.ui.team.Pull].enabled": true
   }
  },
  {
   "tool": "eclipse_run_workbench_command",
   "label": "and the same by evaluation",
   "arguments": {
    "command": "org.eclipse.egit.ui.team.Pull",
    "dryRun": true,
    "selection": [
     "/org.eclipse.compare"
    ]
   },
   "expect": {
    "forSelection.enabledForSelection": true
   }
  },
  {
   "tool": "eclipse_run_workbench_command",
   "label": "but not for a closed project",
   "arguments": {
    "command": "org.eclipse.egit.ui.team.Pull",
    "dryRun": true,
    "selection": [
     "/org.eclipse.compare.tests"
    ]
   },
   "expect": {
    "forSelection.enabledForSelection": false
   }
  }
 ]
}
