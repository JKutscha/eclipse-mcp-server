{
 "atomic": true,
 "steps": [
  {
   "tool": "eclipse_open",
   "label": "open a java file",
   "arguments": {
    "path": "/org.eclipse.core.expressions/src/org/eclipse/core/expressions/Expression.java",
    "line": 46
   },
   "expect": {
    "opened": true
   }
  },
  {
   "tool": "eclipse_type_text",
   "label": "type a prefix",
   "arguments": {
    "text": "\n\t\tString sRun = \"\"; sRun.to"
   },
   "expect": {
    "dirty": true
   }
  },
  {
   "tool": "eclipse_run_workbench_command",
   "label": "open content assist",
   "arguments": {
    "command": "org.eclipse.ui.edit.text.contentAssist.proposals",
    "timeoutSeconds": 3
   },
   "expect": {
    "executed": true
   }
  },
  {
   "tool": "eclipse_get_widget_tree",
   "label": "read the proposals",
   "arguments": {
    "shell": "popup",
    "path": "0",
    "includeRows": true,
    "maxResults": 4
   },
   "expect": {
    "found": true,
    "widgets.1.kind": "row",
    "widgets.1.text": {
     "exists": true
    }
   }
  },
  {
   "tool": "eclipse_dismiss_dialog",
   "label": "close the popup",
   "arguments": {
    "dryRun": false
   },
   "expect": {
    "dismissed": true,
    "kind": "popup"
   }
  }
 ]
}