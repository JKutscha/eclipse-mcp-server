<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="com.vogella.eclipse.mcp.core.tools">
      <tool class="com.vogella.eclipse.mcp.ui.internal.GetEditorContextTool"/>
      <tool class="com.vogella.eclipse.mcp.ui.internal.OpenInEditorTool"/>
      <tool class="com.vogella.eclipse.mcp.ui.internal.SamplingTools$Start"/>
      <tool class="com.vogella.eclipse.mcp.ui.internal.SamplingTools$Stop"/>
      <tool class="com.vogella.eclipse.mcp.ui.internal.ScreenshotTools$ListTargets"/>
      <tool class="com.vogella.eclipse.mcp.ui.internal.ScreenshotTools$Capture"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page id="com.vogella.eclipse.mcp.ui.preferences"
            name="MCP Server"
            category="org.eclipse.ui.preferencePages.Workbench"
            class="com.vogella.eclipse.mcp.ui.internal.McpPreferencePage">
      </page>
   </extension>

   <extension point="org.eclipse.ui.startup">
      <startup class="com.vogella.eclipse.mcp.ui.internal.McpStartup"/>
   </extension>

</plugin>
